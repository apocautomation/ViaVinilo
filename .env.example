# Copiar a .env y completar. Nunca commitear el .env.

# Zona horaria del negocio (los datos se guardan en UTC)
TZ_BUSINESS=America/Argentina/Salta

# Base de datos (docker compose levanta Postgres en el 5432)
DATABASE_URL=postgresql://viavinilo:viavinilo@localhost:5432/viavinilo?schema=public

# Redis para las colas del worker (BullMQ)
REDIS_URL=redis://localhost:6379

# Puertos de las apps
API_PORT=3001
WEB_PORT=3000
PWA_PORT=3002

# Dominio de las casillas de sector (dtf@, granformato@, ...). Pendiente: accesos de Hostinger.
SEED_MAIL_DOMAIN=viavinilo.local

# Almacenamiento de archivos de órdenes (disco local en desarrollo)
STORAGE_DIR=./storage
