# Copiar a .env y completar. Nunca commitear el .env.

# Zona horaria del negocio (los datos se guardan en UTC)
TZ_BUSINESS=America/Argentina/Salta

# Base de datos (docker compose levanta Postgres en el 5432)
DATABASE_URL=postgresql://viavinilo:viavinilo@localhost:5432/viavinilo?schema=public

# Redis para las colas del worker (BullMQ)
REDIS_URL=redis://localhost:6379

# Puertos de las apps
API_PORT=3001
WEB_PORT=3000
PWA_PORT=3002

# Dominio de las casillas de sector (dtf@, granformato@, ...). En producción es viavinilo.com (D-043).
SEED_MAIL_DOMAIN=viavinilo.local

# Orígenes del navegador que pueden llamar a la API (backoffice y app de clientes).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# URL de la API que usa el backoffice desde el navegador (se fija al compilar apps/web).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Cada cuánto el tablero revisa si hay cambios para avisar en vivo (milisegundos).
BOARD_POLL_MS=2000

# Firma de las sesiones del personal. Mínimo 32 caracteres; generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Usuario dueño que crea el seed (opcional). La contraseña solo se usa al crearlo.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=

# ── Lectura de casillas de mail (worker) ──
# imap = casillas de Hostinger; mailhog = desarrollo local (docker compose); off = apagado.
MAIL_SOURCE=mailhog
MAIL_POLL_SECONDS=60
MAILHOG_URL=http://localhost:8025

# IMAP de Hostinger. Una casilla por sector: IMAP_<SECTOR>_USER / IMAP_<SECTOR>_PASS.
# Sectores: DTF, DTF_UV, GRAN_FORMATO, LATEX, CALANDRADO, SUBLIMACION. Sin credenciales, el sector no se lee.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_DTF_USER=
IMAP_DTF_PASS=

# Envío de mails a clientes (mail a remitentes nuevos y, más adelante, avisos). En desarrollo va a MailHog.
SMTP_URL=smtp://localhost:1025
SMTP_FROM="Via Vinilo <no-responder@viavinilo.local>"
# WhatsApp de la empresa (link wa.me) que va en el mail a remitentes que no son clientes (D-038).
# No hay autoalta: el cliente escribe por WhatsApp y un asesor lo da de alta en el ERP.
SUPPORT_WHATSAPP_URL=
# Lo mismo para la app de clientes ("¿Todavía no sos cliente?"). Se fija al compilar apps/pwa.
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=

# Almacenamiento de archivos de órdenes (disco local en desarrollo)
STORAGE_DIR=./storage
