{
  "name": "@viavinilo/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm prisma:generate && vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@viavinilo/contracts": "workspace:*",
    "bullmq": "^5.0.0",
    "imapflow": "^2.12.1",
    "ioredis": "^5.0.0",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "prisma": "6.19.3",
    "smtp-server": "^3.21.6",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
