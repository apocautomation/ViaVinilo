// Modelo de datos de la Etapa 1. Ver docs/DESARROLLO.md (decisiones) y docs/SPEC.md §4.
// Montos con Decimal, nunca float. Fechas en UTC; se muestran en America/Argentina/Salta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

/// Debe coincidir con JOB_STATUSES de @viavinilo/contracts. Textos para el cliente en JOB_STATUS_LABELS.
enum JobStatus {
  PENDING_SIGNUP // Alta pendiente (D-014): mail de alguien que todavía no es cliente activo
  RECEIVED // Archivo recibido
  FILE_ERROR // Archivo con error
  QUOTED // Cotizado
  DEPOSIT_RECEIVED // Seña recibida (D-013), solo si la orden requiere seña
  PRINTED // Impreso
  CALENDERING // En proceso de calandra (Sublimación / Calandrado)
  READY // Terminado, listo para retirar
  DELIVERED // Entregado
  CANCELLED // Cancelado
}

/// Alta de clientes validada por un asesor (actualización §2.1).
enum CustomerStatus {
  PENDING
  ACTIVE
  BLOCKED
}

/// Condición frente al IVA, para facturar con ARCA (E3, D-038).
enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

enum JobSource {
  EMAIL
  COUNTER
  WEB // reservado; no hay pedido de impresión por web (D-009)
  WHATSAPP
  API
}

enum PaymentStatus {
  PENDING
  DEPOSIT
  PAID
  CURRENT_ACCOUNT
}

/// Roles mínimos de la E1 (D-017). La gestión completa de roles va en la E3.
enum UserRole {
  OWNER
  PRODUCTION
  ATTENTION
}

// ───────────────────────── Clientes ─────────────────────────

model Customer {
  id                 String             @id @default(cuid())
  /// Número de cliente único y visible (actualización §2.1).
  /// TODO(spec): al migrar desde Tango/Runamatic, decidir si se conservan los números existentes.
  customerNumber     Int                @unique @default(autoincrement())
  firstName          String?
  lastName           String?
  /// Nombre y apellido sin tildes y en minúsculas, para buscar. Lo mantiene el servicio con
  /// customerSearchText() de @viavinilo/contracts; todo el que cree o edite clientes tiene que usarlo.
  searchText         String             @default("")
  /// Clave para identificar al cliente. Opcional mientras el alta está pendiente (D-014).
  dni                String?            @unique
  status             CustomerStatus     @default(PENDING)
  /// Notas internas, nunca visibles para el cliente.
  internalNotes      String?
  isTrade            Boolean            @default(true)
  /// Empresa o marca con la que trabaja el cliente (D-038).
  businessName       String?
  /// Datos fiscales para facturar con ARCA (E3). Opcionales hasta la E3 (D-038).
  /// CUIT con 11 dígitos, sin guiones.
  cuit               String?            @unique
  legalName          String?
  taxCondition       TaxCondition?
  fiscalAddress      String?
  city               String?
  province           String?
  /// Cuenta corriente habilitada (E3).
  creditEnabled      Boolean            @default(false)
  /// { push: boolean, email: boolean }. Sin valor = los dos prendidos (D-038).
  notificationPrefs  Json?
  /// Contraseña de la app (scrypt). La carga el asesor desde el ERP (D-039). Sin valor = no puede entrar.
  appPasswordHash    String?
  /// Último cambio de contraseña: los tokens emitidos antes ya no sirven (D-039).
  appPasswordSetAt   DateTime?
  /// Última invitación a la app enviada desde el ERP (D-049).
  appInvitedAt       DateTime?
  /// De dónde vino el cliente si se importó (ej. "runamatic"). Null = alta en el ERP (D-049).
  importSource       String?
  activations        AppActivation[]
  conversation       Conversation?
  /// Celulares y navegadores donde el cliente aceptó las notificaciones (D-068).
  pushSubscriptions  PushSubscription[]
  approvedAt         DateTime?
  /// Último mail con el link de alta enviado a un remitente nuevo (D-014). Evita mandarlo en cada mail.
  signupInviteSentAt DateTime?
  approvedById       String?
  approvedBy         User?              @relation("CustomerApprovedBy", fields: [approvedById], references: [id])
  emails             CustomerEmail[]
  phones             CustomerPhone[]
  jobs               JobOrder[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@index([status])
  @@index([searchText])
}

/// Un cliente tiene varios emails; con ellos se identifica al remitente de un mail.
model CustomerEmail {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Guardado siempre en minúsculas.
  email      String   @unique
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerPhone {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Formato E.164.
  phone      String   @unique
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/// Estado del bot para un mensaje del cliente (D-056).
enum BotStatus {
  PENDING // el bot tiene que responder
  ANSWERING // lo tomó el worker
  ANSWERED
  HANDOFF // derivó a un asesor
  SKIPPED // el bot se apagó o respondió una persona antes
  ERROR
}

/// Ajustes generales del sistema que se cambian desde el ERP, con quién y cuándo (D-056).
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum MessageChannel {
  APP
  MAIL
}

enum MessageDirection {
  /// Del cliente hacia Via Vinilo.
  IN
  /// De Via Vinilo hacia el cliente.
  OUT
}

/**
 * Un hilo por cliente con todo lo que manda y lo que se le contesta: chat de la app y mails a las
 * casillas de los sectores (D-041, D-045). Si el remitente de un mail todavía no es cliente, el
 * hilo queda por su email hasta que se lo da de alta.
 */
model Conversation {
  id                 String    @id @default(cuid())
  customerId         String?   @unique
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Email del remitente cuando todavía no es cliente.
  contactEmail       String?   @unique
  contactName        String?
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String    @default("")
  /// Mensajes del cliente que el equipo todavía no vio.
  staffUnread        Int       @default(0)
  /// Respuestas por la app que el cliente todavía no vio.
  customerUnread     Int       @default(0)
  /// El bot responde en este chat (D-056). Arranca apagado en todos; además tiene que estar prendido el global.
  botEnabled         Boolean   @default(false)
  /// El bot derivó a un asesor (o el cliente lo pidió): lo resuelve una persona (D-056).
  needsHuman         Boolean   @default(false)
  needsHumanReason   String?
  /// "/reset" (D-061): el bot solo lee la conversación desde acá. El equipo sigue viendo todo el hilo.
  botResetAt         DateTime?
  messages           Message[]
  createdAt          DateTime  @default(now())

  @@index([lastMessageAt])
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       MessageDirection
  channel         MessageChannel
  /// Casilla del sector por la que entró o salió (solo mail).
  sectorId        String?
  sector          Sector?          @relation(fields: [sectorId], references: [id])
  /// Quién lo mandó (mails entrantes): a esa dirección se responde.
  fromEmail       String?
  subject         String?
  body            String
  /// Nombres de los archivos adjuntos, para mostrarlos en el hilo.
  attachments     Json?
  /// Orden que creó este mensaje, si trajo un trabajo.
  jobId           String?
  /// Clave para no repetir un mail entrante: "<sector>:<Message-ID>".
  externalKey     String?          @unique
  /// UID del mail en la casilla del sector: para responder en el mismo hilo (API de Hostinger).
  mailUid         Int?
  /// Quién del equipo lo escribió (mensajes OUT).
  authorId        String?
  author          User?            @relation(fields: [authorId], references: [id])
  /// Mail en cola para los mensajes OUT por mail (D-049).
  outboundEmailId String?
  /// Mensaje OUT escrito por el bot (D-056).
  fromBot         Boolean          @default(false)
  /// Mensajes IN de la app: si el bot tiene que responderlo y cómo terminó (D-056).
  botStatus       BotStatus?
  /// Mensajes OUT de la app: cuándo se procesó la notificación al celular (D-068). null = pendiente.
  pushedAt        DateTime?
  createdAt       DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([botStatus])
}

/// Link para que el cliente cree su contraseña de la app (D-049). Se guarda solo el hash.
model AppActivation {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Email al que se mandó el link, en minúsculas.
  email      String
  tokenHash  String    @unique
  /// "invite" = lo mandó un asesor desde el ERP; "self" = lo pidió el cliente en /activar.
  kind       String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([customerId])
}

enum OutboundEmailStatus {
  PENDING
  SENT
  FAILED
}

/// Mails a clientes en cola (D-049). La API los anota y el worker los manda despacio.
model OutboundEmail {
  id           String              @id @default(cuid())
  to           String
  subject      String
  /// Se reemplaza el link por "[link enviado]" una vez enviado: el link de activación no queda guardado.
  text         String
  kind         String
  customerId   String?
  /// Casilla desde la que sale (respuestas desde la casilla del sector). Sin valor = MAIL_SENDER_ADDRESS.
  fromAddress  String?
  /// Responder en el mismo hilo: UID del mail original en esa casilla (API de Hostinger).
  inReplyToUid Int?
  /// Adjuntos (D-062): [{ name, key, size, mime }]. El worker los lee del almacenamiento al enviar.
  attachments  Json?
  status       OutboundEmailStatus @default(PENDING)
  attempts     Int                 @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([status, createdAt])
}

// ───────────────────────── Personal ─────────────────────────

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  passwordHash      String?
  roles             UserRole[]
  /// Puede ver los totales en pesos de Inicio (D-089). El dueño los ve siempre.
  canSeeBilling     Boolean      @default(false)
  active            Boolean      @default(true)
  /// Sectores de un usuario con rol PRODUCTION.
  sectors           UserSector[]
  jobEvents         JobEvent[]
  approvedCustomers Customer[]   @relation("CustomerApprovedBy")
  auditLogs         AuditLog[]
  messages          Message[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
}

model UserSector {
  userId   String
  sectorId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([userId, sectorId])
}

// ───────────────────────── Producción ─────────────────────────

model Sector {
  id         String          @id @default(cuid())
  /// Código del tablero en mayúsculas (DTF, GRAN_FORMATO…). Texto libre desde D-064: se crean tableros desde el ERP.
  code       String          @unique
  name       String
  /// Casilla de Hostinger del sector (dtf@, granformato@, ...).
  inboxEmail String?         @unique
  active     Boolean         @default(true)
  /// Sub-servicio de otro tablero (D-082): Látex, Ecosolvente, etc. dentro de Gran Formato. Se ve en el tablero del padre.
  parentId   String?
  parent     Sector?         @relation("SectorChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children   Sector[]        @relation("SectorChildren")
  stages     SectorStage[]
  /// Materiales u opciones de impresión (D-095).
  variants   SectorVariant[]
  machines   MachineSector[]
  users      UserSector[]
  jobs       JobOrder[]
  mailbox    MailboxState?
  mailLogs   MailIngestLog[]
  messages   Message[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([parentId])
}

/// Material u opción de impresión de un tablero (D-095): "Glitter" en DTF Textil, "Jersey Set" en Calandra.
model SectorVariant {
  id        String     @id @default(cuid())
  sectorId  String
  sector    Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  /// Código que identifica la opción en el pedido ("DTF-GLI"). Único en todo el sistema.
  code      String     @unique
  name      String
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  jobs      JobOrder[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sectorId])
}

/// Secuencia de estados de cada sector (actualización §2.4). Los pasos son obligatorios.
model SectorStage {
  id       String    @id @default(cuid())
  sectorId String
  sector   Sector    @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  status   JobStatus
  position Int

  @@unique([sectorId, status])
  @@unique([sectorId, position])
}

model Machine {
  id        String          @id @default(cuid())
  name      String          @unique
  active    Boolean         @default(true)
  /// Una máquina puede atender más de un sector (TODO(spec): I-10).
  sectors   MachineSector[]
  jobs      JobOrder[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model MachineSector {
  machineId String
  sectorId  String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sector    Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([machineId, sectorId])
}

/// Producto mínimo para elegir el material en la E1. El catálogo completo es de la E3.
model Product {
  id           String     @id @default(cuid())
  sku          String?    @unique
  name         String
  isPrintMedia Boolean    @default(false)
  widthMeters  Decimal?   @db.Decimal(6, 3)
  active       Boolean    @default(true)
  jobs         JobOrder[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

model JobOrder {
  id                String        @id @default(cuid())
  /// Correlativo; se muestra como VV-000123 (R-JOB-1).
  number            Int           @unique @default(autoincrement())
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  sectorId          String
  sector            Sector        @relation(fields: [sectorId], references: [id])
  machineId         String?
  machine           Machine?      @relation(fields: [machineId], references: [id])
  materialProductId String?
  material          Product?      @relation(fields: [materialProductId], references: [id])
  /// Material u opción de impresión elegida (D-095).
  variantId         String?
  variant           SectorVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Orden original cuando un operador divide un mail en varias órdenes.
  parentJobId       String?
  parentJob         JobOrder?     @relation("JobSplit", fields: [parentJobId], references: [id])
  childJobs         JobOrder[]    @relation("JobSplit")
  status            JobStatus
  priority          Int           @default(0)
  /// Medida, precio y descripción: los edita el empleado y los ve el cliente (actualización §2.4).
  description       String?
  measure           String?
  /// Lo que el cliente declaró en el mail (texto o datos extraídos).
  requestedSpecs    Json?
  /// Resultado del control automático del archivo (D-065): { verdict, reasonCode, detail, effectiveDpi, file }.
  /// Null = todavía no se controló (el worker lo hace al entrar el pedido o al llegar un archivo corregido).
  fileCheck         Json?
  quotedAmount      Decimal?      @db.Decimal(14, 2)
  quotedAt          DateTime?
  depositRequired   Boolean       @default(false)
  depositAmount     Decimal?      @db.Decimal(14, 2)
  depositPaidAt     DateTime?
  paymentStatus     PaymentStatus @default(PENDING)
  estimatedReadyAt  DateTime?
  /// Desde esta fecha corren los 30 días de retención de archivos (D-015).
  deliveredAt       DateTime?
  source            JobSource
  /// Message-ID del mail. Único por sector: el mismo mail con copia a dos casillas crea una orden en cada una.
  sourceMessageId   String?
  /// Links de WeTransfer, Drive u OneDrive del mail.
  externalLinks     String[]
  /// Cuándo se intentó bajar los archivos de esos links (D-072). Null = todavía no. Se intenta una vez.
  linksFetchedAt    DateTime?
  /// Qué pasó con los links que no se pudieron bajar; lo lee el operador en la tarjeta.
  linksNote         String?
  /// Sucursal donde retira el cliente (D-083): "chile" o "san-juan". Null: todavía no se sabe.
  pickupBranch      String?
  files             JobFile[]
  events            JobEvent[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@unique([sectorId, sourceMessageId])
  @@index([sectorId, status])
  @@index([customerId])
  @@index([status, deliveredAt])
  @@index([variantId])
}

model JobFile {
  id         String    @id @default(cuid())
  jobId      String
  job        JobOrder  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename   String
  storageKey String    @unique
  sizeBytes  BigInt
  mime       String
  /// SHA-256 del contenido.
  checksum   String
  /// Fecha en que se borró el archivo del storage por retención (D-015).
  purgedAt   DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([jobId])
}

/// Historial de estados de una orden.
model JobEvent {
  id               String           @id @default(cuid())
  jobId            String
  job              JobOrder         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus       JobStatus?
  toStatus         JobStatus
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  reasonId         String?
  reason           FileErrorReason? @relation(fields: [reasonId], references: [id])
  note             String?
  notifiedCustomer Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([jobId, createdAt])
}

/// Catálogo editable de motivos de "Archivo con error".
model FileErrorReason {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  events    JobEvent[]
}

// ───────────────────────── Ingesta de mails ─────────────────────────

/// Resultado de procesar un mail de una casilla de sector (actualización §2.2: loguear y monitorear).
enum MailIngestResult {
  CREATED // se creó la orden
  PENDING_SIGNUP // remitente con alta pendiente: la orden entra igual al tablero (D-054)
  DUPLICATE // ese Message-ID ya había creado una orden en el sector
  SKIPPED_NO_FILES // sin adjuntos ni links (I-15)
  SKIPPED_AUTO_REPLY // respuesta automática, rebote o lista
  REJECTED_BLOCKED // cliente bloqueado (I-14)
  COMMAND // un comando como "/reset" (D-061): no crea orden
  RESENT // archivo corregido: se sumó a la orden que estaba en "Archivo con error" (D-065)
  ERROR
}

/// Un registro por mail procesado. Sirve para auditar que no se pierdan mails.
model MailIngestLog {
  id        String           @id @default(cuid())
  sectorId  String
  sector    Sector           @relation(fields: [sectorId], references: [id])
  messageId String
  fromEmail String?
  subject   String?
  /// Fecha del mail según su encabezado.
  sentAt    DateTime?
  result    MailIngestResult
  jobId     String?
  fileCount Int              @default(0)
  error     String?
  createdAt DateTime         @default(now())

  @@index([sectorId, createdAt])
  @@index([messageId])
}

/// Estado de lectura de la casilla de cada sector.
model MailboxState {
  id            String    @id @default(cuid())
  sectorId      String    @unique
  sector        Sector    @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  /// UIDVALIDITY de IMAP: si cambia, los UID se reinician y hay que releer.
  uidValidity   BigInt?
  /// Último UID procesado. Se leen solo los mails nuevos y no se tocan las marcas de leído.
  lastUid       Int       @default(0)
  lastPolledAt  DateTime?
  /// Último mail recibido: sirve para alertar si una casilla no recibe nada en horario laboral.
  lastMessageAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

// ───────────────────────── Auditoría ─────────────────────────

/// Cambios de precio, anulaciones, ajustes de stock, cierres de caja y forzados del owner.
model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Suscripción de un navegador o celular a las notificaciones push de la app (D-068).
/// Se borra sola cuando el servicio de push avisa que ya no existe.
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Dirección del servicio de push del navegador (Google, Apple, Mozilla o Microsoft).
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}
