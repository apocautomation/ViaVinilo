# Copiar a deploy/.env EN EL VPS y completar. Nunca commitear el .env (D-037).
# Los secretos se generan en el servidor con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   (o: openssl rand -base64 48 | tr -d '/+=')

TZ_BUSINESS=America/Argentina/Salta

# Contraseña de Postgres (la usa el compose para armar DATABASE_URL).
POSTGRES_PASSWORD=

# Firma de las sesiones del personal. Mínimo 32 caracteres.
JWT_SECRET=

# La API se sirve en /api de cada dominio (deploy/Caddyfile).
# Relativa: el ERP y la app llaman a /api de su propio dominio (mismo origen, sin CORS).
NEXT_PUBLIC_API_URL=/api
CORS_ORIGINS=https://erp.viavinilo.tech,https://viavinilo.tech
BOARD_POLL_MS=2000

# Las casillas reales de los sectores son @viavinilo.com (Hostinger, D-043). viavinilo.tech es solo el sistema.
SEED_MAIL_DOMAIN=viavinilo.com
# Usuario dueño que crea el seed (opcional). La contraseña solo se usa al crearlo.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=

# Lectura de casillas: off hasta tener las casillas por sector en Hostinger (D-027).
MAIL_SOURCE=off
MAIL_POLL_SECONDS=60
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_DTF_USER=
IMAP_DTF_PASS=

# Envío de mails a remitentes nuevos (worker). Opcional: el ingreso a la app no lo necesita (D-039).
SMTP_URL=
SMTP_FROM="Via Vinilo <no-responder@viavinilo.tech>"
# WhatsApp de la empresa (https://wa.me/549...). Pendiente: el número (D-038).
SUPPORT_WHATSAPP_URL=

STORAGE_DIR=/app/storage
